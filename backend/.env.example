# Local: python -m scripts.configure_local, then run uvicorn.
FINPILOT_MODE=development
FINPILOT_LOCAL_USER=finpilot-local
FINPILOT_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
FINPILOT_REQUIRE_GEMINI=0
# FINPILOT_DATA_DIR=/absolute/path/to/private/finpilot-data
# *_FILE overrides are optional. Local authentication defaults to .secrets/.
